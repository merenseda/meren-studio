{
  "name": "meren-studio-suite",
  "version": "2.0.0",
  "description": "Meren Suite - Meren Studio (No-Code Editör) ve Meren Viewer (Salt Okunur Görüntüleyici)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:viewer": "electron viewer/src/main.js",
    "test": "node test/testEngine.js",
    "dist:studio": "electron-builder --win nsis",
    "dist:viewer": "electron-builder --win nsis -c.directories.app=viewer -c.directories.output=dist/viewer -c.productName=\"Meren Viewer\" -c.appId=com.meren.viewer -c.nsis.artifactName=\"MerenViewer-Setup-1.0.0.exe\"",
    "dist:all": "npm run dist:studio && npm run dist:viewer"
  },
  "build": {
    "appId": "com.meren.studio",
    "productName": "Meren Studio",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "fileAssociations": [
        {
          "ext": "hrav",
          "name": "Hrav Şifreli Dokümanı",
          "description": "Meren Studio No-Code Güvenli Dokümanı",
          "role": "Editor"
        },
        {
          "ext": "meren",
          "name": "Meren Şifreli Dokümanı",
          "description": "Meren Studio Güvenli Dokümanı",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meren Studio",
      "artifactName": "MerenStudio-Setup-${version}.exe",
      "uninstallDisplayName": "Meren Studio Kaldır"
    },
    "portable": {
      "artifactName": "MerenStudio-Portable.exe"
    },
    "files": [
      "src/**/*"
    ]
  },
  "keywords": [
    "meren",
    "no-code",
    "hrav",
    "meren-viewer",
    "encryption",
    "aes-256"
  ],
  "author": "Meren",
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3"
  }
}
